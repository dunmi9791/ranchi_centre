<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ranchi" model="ir.module.category">
        <field name="name">Ranchi Centre</field>
        <field name="description">Microfinance operations: members, unions, loans and savings.</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_ranchi_officer" model="res.groups">
        <field name="name">Credit Officer</field>
        <field name="category_id" ref="module_category_ranchi"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Sees and works only the unions they are assigned to.</field>
    </record>
    <record id="group_ranchi_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="category_id" ref="module_category_ranchi"/>
        <field name="implied_ids" eval="[(4, ref('group_ranchi_officer'))]"/>
        <field name="comment">All branch records, posts savings and disbursements. Collections are posted by a manager after the cash handover.</field>
    </record>
    <record id="group_ranchi_manager" model="res.groups">
        <field name="name">Loan Product Manager</field>
        <field name="category_id" ref="module_category_ranchi"/>
        <field name="implied_ids" eval="[(3, ref('group_ranchi_accountant')), (4, ref('group_ranchi_officer'))]"/>
        <field name="comment">Manages the field collections of the loan types that list them as manager (e.g. Ranchi weekly or Rapid daily): sees only those unions, approves, confirms cash and posts.</field>
    </record>
    <record id="group_ranchi_general_manager" model="res.groups">
        <field name="name">General Manager</field>
        <field name="category_id" ref="module_category_ranchi"/>
        <field name="implied_ids" eval="[(4, ref('group_ranchi_manager')), (4, ref('group_ranchi_accountant'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Full access to every loan product, including configuration.</field>
    </record>
    <record id="group_ranchi_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="category_id" ref="module_category_ranchi"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Read-only access to every record in the branch.</field>
    </record>

    <!-- ===================== Multi-company rules (global) ===================== -->
    <record id="rule_union_company" model="ir.rule">
        <field name="name">Union: own companies</field>
        <field name="model_id" ref="model_ranchi_union"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_loan_company" model="ir.rule">
        <field name="name">Loan: own companies</field>
        <field name="model_id" ref="model_ranchi_loan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_installment_company" model="ir.rule">
        <field name="name">Installment: own companies</field>
        <field name="model_id" ref="model_ranchi_loan_installment"/>
