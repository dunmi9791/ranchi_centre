        <field name="model_id" ref="model_ranchi_lapse_adjustment"/>
        <field name="groups" eval="[(4, ref('group_ranchi_manager'))]"/>
        <field name="domain_force">[('loan_id.loan_type_id.manager_ids', 'in', user.id)]</field>
    </record>
    <!-- Members of the other product are hidden from a product manager; non-members and members
         without a union stay visible. Branch staff get an explicit open rule so the General Manager
         (who is also a product manager) is not restricted. -->
    <record id="rule_partner_product_manager" model="ir.rule">
        <field name="name">Partner: product manager sees members of own loan types</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('group_ranchi_manager'))]"/>
        <field name="domain_force">['|', '|', ('is_ranchi_member', '=', False), ('union_id', '=', False), ('union_id.loan_type_id.manager_ids', 'in', user.id)]</field>
    </record>
    <record id="rule_partner_branch" model="ir.rule">
        <field name="name">Partner: branch staff see all members</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('group_ranchi_accountant')), (4, ref('group_ranchi_auditor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- ===================== Portal members: own records ===================== -->
    <record id="rule_union_portal" model="ir.rule">
        <field name="name">Union: member sees own union</field>
        <field name="model_id" ref="model_ranchi_union"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('member_ids', 'in', [user.partner_id.id])]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_loan_portal" model="ir.rule">
        <field name="name">Loan: member sees own loans</field>
        <field name="model_id" ref="model_ranchi_loan"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('member_id', '=', user.partner_id.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_installment_portal" model="ir.rule">
        <field name="name">Installment: member sees own installments</field>
        <field name="model_id" ref="model_ranchi_loan_installment"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('loan_id.member_id', '=', user.partner_id.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_savings_tx_portal" model="ir.rule">
        <field name="name">Savings transaction: member sees own</field>
        <field name="model_id" ref="model_ranchi_savings_transaction"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('member_id', '=', user.partner_id.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
