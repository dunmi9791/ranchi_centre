    <record id="rule_savings_tx_company" model="ir.rule">
        <field name="name">Savings transaction: own companies</field>
        <field name="model_id" ref="model_ranchi_savings_transaction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
