        <field name="name">Union: product manager sees own loan types</field>
        <field name="model_id" ref="model_ranchi_union"/>
        <field name="groups" eval="[(4, ref('group_ranchi_manager'))]"/>
        <field name="domain_force">[('loan_type_id.manager_ids', 'in', user.id)]</field>
    </record>
    <record id="rule_loan_product_manager" model="ir.rule">
        <field name="name">Loan: product manager sees own loan types</field>
        <field name="model_id" ref="model_ranchi_loan"/>
