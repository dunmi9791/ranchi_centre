    <record id="rule_lapse_company" model="ir.rule">
        <field name="name">Lapse adjustment: own companies</field>
        <field name="model_id" ref="model_ranchi_lapse_adjustment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_savings_rate_company" model="ir.rule">
        <field name="name">Savings rate: own companies</field>
        <field name="model_id" ref="model_ranchi_savings_rate"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_loan_type_company" model="ir.rule">
        <field name="name">Loan type: own companies</field>
        <field name="model_id" ref="model_ranchi_loan_type"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_gateway_event_company" model="ir.rule">
        <field name="name">Gateway event: own companies</field>
        <field name="model_id" ref="model_ranchi_gateway_event"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

