    </record>
    <record id="rule_disbursement_company" model="ir.rule">
        <field name="name">Disbursement: own companies</field>
        <field name="model_id" ref="model_ranchi_disbursement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
