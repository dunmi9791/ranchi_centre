<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_disbursement_roll" model="ir.actions.report">
        <field name="name">Disbursement Master Roll</field>
        <field name="model">ranchi.daily.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ranchi_centre.report_disbursement_roll</field>
        <field name="report_file">ranchi_centre.report_disbursement_roll</field>
        <field name="print_report_name">'Disbursement Master Roll - %s to %s' % (object.date_from, object.date_to)</field>
        <field name="paperformat_id" ref="paperformat_ranchi_portfolio"/>
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="action_report_daily_collection" model="ir.actions.report">
        <field name="name">Daily Collection Sheet</field>
        <field name="model">ranchi.daily.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ranchi_centre.report_daily_collection</field>
        <field name="report_file">ranchi_centre.report_daily_collection</field>
        <field name="print_report_name">'Daily Collection Sheet - %s to %s' % (object.date_from, object.date_to)</field>
        <field name="paperformat_id" ref="paperformat_ranchi_portfolio"/>
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="action_report_daily_defaults" model="ir.actions.report">
        <field name="name">Defaults of the Day</field>
        <field name="model">ranchi.daily.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ranchi_centre.report_daily_defaults</field>
        <field name="report_file">ranchi_centre.report_daily_defaults</field>
        <field name="print_report_name">'Defaults - %s to %s' % (object.date_from, object.date_to)</field>
        <field name="paperformat_id" ref="paperformat_ranchi_portfolio"/>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="daily_report_title">
        <div class="row mb-2">
            <div class="col-8">
                <h3 class="mb-0" t-out="title"/>
                <div t-if="subtitle" t-out="subtitle"/>
            </div>
            <div class="col-4 text-end small">
                <t t-if="wizard.date_from == wizard.date_to">
                    Date: <span t-out="wizard.date_from" t-options="{'widget': 'date'}"/>
                </t>
                <t t-else="">
                    Period: <span t-out="wizard.date_from" t-options="{'widget': 'date'}"/>
                    to <span t-out="wizard.date_to" t-options="{'widget': 'date'}"/>
                </t>
                <br/>
                <span t-if="wizard.credit_officer_ids">Credit officers: <t t-out="', '.join(wizard.credit_officer_ids.mapped('name'))"/><br/></span>
                <span t-if="wizard.loan_type_ids">Loan types: <t t-out="', '.join(wizard.loan_type_ids.mapped('name'))"/><br/></span>
                Printed <span t-out="today" t-options="{'widget': 'date'}"/>
            </div>
        </div>
    </template>

    <!-- ===================== Disbursement master roll ===================== -->
    <template id="report_disbursement_roll">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <t t-set="money" t-value="{'widget': 'monetary', 'display_currency': currency}"/>
                    <t t-call="ranchi_centre.daily_report_title">
                        <t t-set="title" t-value="'Disbursement Master Roll'"/>
                    </t>

                    <p t-if="not roll['branches']">No loans were disbursed in this period.</p>

                    <!-- Summary by credit officer -->
                    <table t-if="roll['branches']" class="table table-sm o_main_table small">
                        <thead>
                            <tr>
                                <th>Branch</th>
                                <th>Credit Officer</th>
                                <th class="text-end">Loans</th>
                                <th class="text-end">Principal</th>
                                <th class="text-end">Service Charge</th>
                                <th class="text-end">Fees</th>
                                <th class="text-end">Total Repayable</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="roll['branches']" t-as="branch">
                                <tr t-foreach="branch['officers']" t-as="off">
                                    <td t-out="branch['company'].name"/>
                                    <td t-out="off['officer'].name or 'No Credit Officer'"/>
                                    <td class="text-end" t-out="off['totals']['loans']"/>
                                    <td class="text-end" t-out="off['totals']['principal']" t-options="money"/>
                                    <td class="text-end" t-out="off['totals']['service']" t-options="money"/>
                                    <td class="text-end" t-out="off['totals']['fees']" t-options="money"/>
                                    <td class="text-end" t-out="off['totals']['repayable']" t-options="money"/>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold border-top">
                                <td colspan="2">Total</td>
                                <td class="text-end" t-out="roll['totals']['loans']"/>
                                <td class="text-end" t-out="roll['totals']['principal']" t-options="money"/>
                                <td class="text-end" t-out="roll['totals']['service']" t-options="money"/>
                                <td class="text-end" t-out="roll['totals']['fees']" t-options="money"/>
                                <td class="text-end" t-out="roll['totals']['repayable']" t-options="money"/>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- Master roll -->
                    <t t-foreach="roll['branches']" t-as="branch">
                        <t t-foreach="branch['officers']" t-as="off">
                            <h5 class="mt-4 mb-1">
                                <t t-out="off['officer'].name or 'No Credit Officer'"/>
                                <small class="text-muted"> · <t t-out="branch['company'].name"/></small>
                            </h5>
                            <table class="table table-sm small">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Disbursed</th>
                                        <th>Loan</th>
                                        <th>Member No.</th>
                                        <th>Member</th>
                                        <th>Phone</th>
                                        <th>Loan Type</th>
                                        <th>Stage</th>
                                        <th class="text-end">Principal</th>
                                        <th class="text-end">Service</th>
                                        <th class="text-end">Fees</th>
                                        <th class="text-end">Repayable</th>
                                        <th class="text-end">Installment</th>
                                        <th>First Due</th>
                                        <th>Last Due</th>
                                        <th>Paid Via</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="off['unions']" t-as="u">
                                        <tr class="table-light fw-bold">
                                            <td colspan="16">
                                                <t t-out="u['union'].name or 'No Union'"/>
                                                <small class="text-muted" t-if="u['union'].code"> (<t t-out="u['union'].code"/>)</small>
                                            </td>
                                        </tr>
                                        <tr t-foreach="u['items']" t-as="r">
                                            <td t-out="r_index + 1"/>
                                            <td t-out="r['loan'].date_disbursed" t-options="{'widget': 'date'}"/>
                                            <td t-out="r['loan'].name"/>
                                            <td t-out="r['member'].member_number or ''"/>
                                            <td t-out="r['member'].name"/>
                                            <td t-out="r['phone']"/>
                                            <td t-out="r['loan'].loan_type_id.name"/>
                                            <td t-out="r['loan'].stage_id.name or ''"/>
                                            <td class="text-end" t-out="r['principal']" t-options="money"/>
                                            <td class="text-end" t-out="r['service']" t-options="money"/>
                                            <td class="text-end" t-out="r['fees']" t-options="money"/>
                                            <td class="text-end" t-out="r['repayable']" t-options="money"/>
                                            <td class="text-end">
                                                <t t-out="r['installment']" t-options="money"/>
                                                <small class="text-muted">× <t t-out="r['loan'].installment_count"/></small>
                                            </td>
                                            <td t-out="r['loan'].date_first_due" t-options="{'widget': 'date'}"/>
                                            <td t-out="r['loan'].date_last_due" t-options="{'widget': 'date'}"/>
                                            <td>
                                                <t t-if="r['disbursement']">
                                                    <span t-field="r['disbursement'].provider"/>
                                                    <small class="text-muted" t-if="r['disbursement'].provider_reference"><br/><t t-out="r['disbursement'].provider_reference"/></small>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr class="fst-italic">
                                            <td colspan="8" class="text-end">Union total (<t t-out="u['totals']['loans']"/> loans)</td>
                                            <td class="text-end" t-out="u['totals']['principal']" t-options="money"/>
                                            <td class="text-end" t-out="u['totals']['service']" t-options="money"/>
                                            <td class="text-end" t-out="u['totals']['fees']" t-options="money"/>
                                            <td class="text-end" t-out="u['totals']['repayable']" t-options="money"/>
                                            <td colspan="4"/>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr class="fw-bold border-top">
                                        <td colspan="8" class="text-end">Officer total (<t t-out="off['totals']['loans']"/> loans)</td>
                                        <td class="text-end" t-out="off['totals']['principal']" t-options="money"/>
                                        <td class="text-end" t-out="off['totals']['service']" t-options="money"/>
                                        <td class="text-end" t-out="off['totals']['fees']" t-options="money"/>
                                        <td class="text-end" t-out="off['totals']['repayable']" t-options="money"/>
                                        <td colspan="4"/>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <!-- ===================== Shared pieces for collection and default reports ===================== -->
    <template id="daily_summary_table">
        <table class="table table-sm o_main_table small">
            <thead>
                <tr>
                    <th>Credit Officer</th>
                    <th>Date</th>
                    <th class="text-end">Members</th>
                    <th class="text-end">Expected</th>
                    <th class="text-end">Arrears B/F</th>
                    <th class="text-end">Loan Collected</th>
                    <th class="text-end">Savings</th>
                    <th class="text-end">Fees</th>
                    <th class="text-end">Total Collected</th>
                    <th class="text-end">Shortfall</th>
                    <th class="text-end">Defaulters</th>
                    <th class="text-end">Repayment Rate</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="sheet['summary']" t-as="off">
                    <tr t-foreach="off['days']" t-as="d">
                        <td><t t-if="d_first" t-out="off['officer'].name or 'No Credit Officer'"/></td>
                        <td t-out="d['day']" t-options="{'widget': 'date'}"/>
                        <t t-set="totals" t-value="d['totals']"/>
                        <t t-call="ranchi_centre.daily_summary_cells"/>
                    </tr>
                    <tr t-if="len(off['days']) &gt; 1" class="fw-bold">
                        <td colspan="2" class="text-end">Total <t t-out="off['officer'].name or ''"/></td>
                        <t t-set="totals" t-value="off['totals']"/>
                        <t t-call="ranchi_centre.daily_summary_cells"/>
                    </tr>
                </t>
            </tbody>
            <tfoot>
                <tr class="fw-bold border-top">
                    <td colspan="2">Grand Total</td>
                    <t t-set="totals" t-value="sheet['totals']"/>
                    <t t-call="ranchi_centre.daily_summary_cells"/>
                </tr>
            </tfoot>
        </table>
    </template>

    <template id="daily_summary_cells">
        <t t-set="money" t-value="{'widget': 'monetary', 'display_currency': currency}"/>
        <td class="text-end" t-out="totals['members']"/>
        <td class="text-end" t-out="totals['expected']" t-options="money"/>
        <td class="text-end" t-out="totals['arrears_bf']" t-options="money"/>
        <td class="text-end" t-out="totals['repaid']" t-options="money"/>
        <td class="text-end" t-out="totals['savings']" t-options="money"/>
        <td class="text-end">
            <t t-out="totals['fees']" t-options="money"/>
            <small t-if="totals.get('fees_due')" class="text-muted d-block">of <t t-out="totals['fees_due']" t-options="money"/> due</small>
        </td>
        <td class="text-end" t-out="totals['total']" t-options="money"/>
        <td t-att-class="'text-end text-danger fw-bold' if totals['shortfall'] else 'text-end'"
            t-out="totals['shortfall']" t-options="money"/>
        <td class="text-end" t-out="totals['defaulters']"/>
        <td class="text-end">
            <t t-if="totals['expected']" t-out="'%.1f%%' % pct(totals['met'], totals['expected'])"/>
            <t t-else="">-</t>
        </td>
    </template>

    <template id="daily_report_notes">
        <p class="small text-muted mt-3">
            Expected is the unpaid part of the installments due that day when the day began, so members who paid
            ahead are not expected to pay. Arrears B/F is what was still unpaid from earlier installments.
            Loan collected counts repayments dated that day plus cash submitted by the officer and still waiting
            for the manager's confirmation (marked *). Payments clear arrears before the day's installment;
            shortfall is what remains unpaid of the day's installment and every member with a shortfall is a
            defaulter. Repayment rate is the share of the expected amount that was met. Fees "of X due" is what
            the member still owed in registration fees and fees before disbursement when the day began; fees are
            only paid through these collections and are not part of the expected amount or the shortfall.
        </p>
    </template>

    <!-- ===================== Daily collection sheet ===================== -->
    <template id="report_daily_collection">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <t t-call="ranchi_centre.daily_report_title">
                        <t t-set="title" t-value="'Daily Collection Sheet: Expected vs Collected'"/>
                    </t>
                    <p t-if="not sheet['summary']">Nothing was due or collected in this period.</p>
                    <t t-else="">
                        <h5>Summary by credit officer</h5>
                        <t t-call="ranchi_centre.daily_summary_table"/>
                    </t>
                    <t t-call="ranchi_centre.daily_report_notes"/>
                </div>
            </t>
            <t t-if="wizard.include_details">
                <t t-foreach="sheet['days']" t-as="d">
                    <t t-foreach="d['tree']['branches']" t-as="branch">
                        <t t-foreach="branch['officers']" t-as="off">
                            <t t-call="web.external_layout">
                                <t t-set="company" t-value="branch['company']"/>
                                <div class="page">
                                    <t t-set="money" t-value="{'widget': 'monetary', 'display_currency': currency}"/>
                                    <div class="row mb-2">
                                        <div class="col-8">
                                            <h4 class="mb-0">Collection Sheet: <t t-out="off['officer'].name or 'No Credit Officer'"/></h4>
                                            <div>Branch: <t t-out="branch['company'].name"/></div>
                                        </div>
                                        <div class="col-4 text-end">
                                            <h5 class="mb-0" t-out="d['day']" t-options="{'widget': 'date'}"/>
                                        </div>
                                    </div>
                                    <table class="table table-sm small">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>Member</th>
                                                <th>Phone</th>
                                                <th>Loan</th>
                                                <th class="text-end">Installment</th>
                                                <th class="text-end">Expected</th>
                                                <th class="text-end">Arrears B/F</th>
                                                <th class="text-end">Loan Collected</th>
                                                <th class="text-end">Savings</th>
                                                <th class="text-end">Fees</th>
                                                <th class="text-end">Total</th>
                                                <th class="text-end">Shortfall</th>
                                                <th class="text-end">Arrears C/F</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="off['unions']" t-as="u">
                                                <tr class="table-light fw-bold">
                                                    <td colspan="13">
                                                        <t t-out="u['union'].name or 'No Union'"/>
                                                        <small class="text-muted" t-if="u['union'].code"> (<t t-out="u['union'].code"/>)</small>
                                                    </td>
                                                </tr>
                                                <tr t-foreach="u['items']" t-as="r" t-att-class="'text-danger' if r['shortfall'] else ''">
                                                    <td t-out="r_index + 1"/>
                                                    <td>
                                                        <t t-out="r['member'].name"/>
                                                        <small class="text-muted" t-if="r['member'].member_number"> <t t-out="r['member'].member_number"/></small>
                                                    </td>
                                                    <td t-out="r['phone']"/>
                                                    <td t-out="r['loan'].name or ''"/>
                                                    <td class="text-end"><t t-if="r['installment']" t-out="r['installment']" t-options="money"/></td>
                                                    <td class="text-end" t-out="r['expected']" t-options="money"/>
                                                    <td class="text-end" t-out="r['arrears_bf']" t-options="money"/>
                                                    <td class="text-end">
                                                        <t t-out="r['repaid']" t-options="money"/><t t-if="r['pending']">*</t>
                                                        <small t-if="r['from_savings']" class="text-muted"><br/>(<t t-out="r['from_savings']" t-options="money"/> from savings)</small>
                                                    </td>
                                                    <td class="text-end" t-out="r['savings']" t-options="money"/>
                                                    <td class="text-end">
                                                        <t t-out="r['fees']" t-options="money"/>
                                                        <small t-if="r['fees_due']" class="text-muted d-block">of <t t-out="r['fees_due']" t-options="money"/> due</small>
                                                    </td>
                                                    <td class="text-end" t-out="r['total']" t-options="money"/>
                                                    <td class="text-end fw-bold"><t t-if="r['shortfall']" t-out="r['shortfall']" t-options="money"/></td>
                                                    <td class="text-end" t-out="r['arrears_cf']" t-options="money"/>
                                                </tr>
                                                <tr class="fst-italic">
                                                    <td colspan="5" class="text-end">Union total</td>
                                                    <t t-set="totals" t-value="u['totals']"/>
                                                    <td class="text-end" t-out="totals['expected']" t-options="money"/>
                                                    <td class="text-end" t-out="totals['arrears_bf']" t-options="money"/>
                                                    <td class="text-end" t-out="totals['repaid']" t-options="money"/>
                                                    <td class="text-end" t-out="totals['savings']" t-options="money"/>
                                                    <td class="text-end">
                                                        <t t-out="totals['fees']" t-options="money"/>
                                                        <small t-if="totals['fees_due']" class="text-muted d-block">of <t t-out="totals['fees_due']" t-options="money"/> due</small>
                                                    </td>
                                                    <td class="text-end" t-out="totals['total']" t-options="money"/>
                                                    <td class="text-end" t-out="totals['shortfall']" t-options="money"/>
                                                    <td/>
                                                </tr>
                                            </t>
                                        </tbody>
                                        <tfoot>
                                            <tr class="fw-bold border-top">
                                                <t t-set="totals" t-value="off['totals']"/>
                                                <td colspan="5" class="text-end">
                                                    Officer total · <t t-out="totals['members']"/> members,
                                                    <t t-out="totals['defaulters']"/> defaulters
                                                </td>
                                                <td class="text-end" t-out="totals['expected']" t-options="money"/>
                                                <td class="text-end" t-out="totals['arrears_bf']" t-options="money"/>
                                                <td class="text-end" t-out="totals['repaid']" t-options="money"/>
                                                <td class="text-end" t-out="totals['savings']" t-options="money"/>
                                                <td class="text-end">
                                                    <t t-out="totals['fees']" t-options="money"/>
                                                    <small t-if="totals['fees_due']" class="text-muted d-block">of <t t-out="totals['fees_due']" t-options="money"/> due</small>
                                                </td>
                                                <td class="text-end" t-out="totals['total']" t-options="money"/>
                                                <td class="text-end text-danger" t-out="totals['shortfall']" t-options="money"/>
                                                <td/>
                                            </tr>
                                        </tfoot>
                                    </table>
                                    <p t-if="off['totals']['pending']" class="small text-muted">
                                        * <t t-out="off['totals']['pending']" t-options="money"/> submitted by the officer and awaiting the manager's cash confirmation.
                                    </p>
                                    <div class="row mt-4 small">
                                        <div class="col-4">Credit officer: ____________________</div>
                                        <div class="col-4">Received by: ____________________</div>
                                        <div class="col-4">Date: ____________________</div>
                                    </div>
                                </div>
                            </t>
                        </t>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <!-- ===================== Defaults of the day ===================== -->
    <template id="report_daily_defaults">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <t t-set="money" t-value="{'widget': 'monetary', 'display_currency': currency}"/>
                    <t t-call="ranchi_centre.daily_report_title">
                        <t t-set="title" t-value="'Defaults of the Day'"/>
                    </t>
                    <p t-if="not sheet['summary']">No member defaulted in this period.</p>
                    <t t-foreach="sheet['days']" t-as="d">
                        <t t-if="d['tree']['branches']">
                            <h4 class="mt-3 mb-1">
                                <span t-out="d['day']" t-options="{'widget': 'date'}"/>
                                <small class="text-muted">
                                    · <t t-out="d['tree']['totals']['defaulters']"/> defaulters,
                                    shortfall <t t-out="d['tree']['totals']['shortfall']" t-options="money"/>
                                </small>
                            </h4>
                            <table class="table table-sm small">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Member</th>
                                        <th>Phone</th>
                                        <th>Loan</th>
                                        <th class="text-end">Expected</th>
                                        <th class="text-end">Paid Towards It</th>
                                        <th class="text-end">Shortfall</th>
                                        <th class="text-end">Arrears B/F</th>
                                        <th class="text-end">Total Arrears</th>
                                        <th class="text-end">Days Late</th>
                                        <th class="text-end">Loan Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="d['tree']['branches']" t-as="branch">
                                        <t t-foreach="branch['officers']" t-as="off">
                                            <tr class="table-secondary fw-bold">
                                                <td colspan="11">
                                                    <t t-out="off['officer'].name or 'No Credit Officer'"/>
                                                    <small class="text-muted"> · <t t-out="branch['company'].name"/>
                                                        · <t t-out="off['totals']['defaulters']"/> defaulters,
                                                        shortfall <t t-out="off['totals']['shortfall']" t-options="money"/></small>
                                                </td>
                                            </tr>
                                            <t t-foreach="off['unions']" t-as="u">
                                                <tr class="table-light">
                                                    <td colspan="11"><t t-out="u['union'].name or 'No Union'"/></td>
                                                </tr>
                                                <tr t-foreach="u['items']" t-as="r">
                                                    <td t-out="r_index + 1"/>
                                                    <td>
                                                        <t t-out="r['member'].name"/>
                                                        <small class="text-muted" t-if="r['member'].member_number"> <t t-out="r['member'].member_number"/></small>
                                                    </td>
                                                    <td t-out="r['phone']"/>
                                                    <td t-out="r['loan'].name or ''"/>
                                                    <td class="text-end" t-out="r['expected']" t-options="money"/>
                                                    <td class="text-end"><t t-out="r['met']" t-options="money"/><t t-if="r['pending']">*</t></td>
                                                    <td class="text-end fw-bold text-danger" t-out="r['shortfall']" t-options="money"/>
                                                    <td class="text-end" t-out="r['arrears_bf']" t-options="money"/>
                                                    <td class="text-end" t-out="r['arrears_cf']" t-options="money"/>
                                                    <td class="text-end" t-out="r['days_late']"/>
                                                    <td class="text-end" t-out="r['loan'].balance" t-options="money"/>
                                                </tr>
                                            </t>
                                        </t>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr class="fw-bold border-top">
                                        <t t-set="totals" t-value="d['tree']['totals']"/>
                                        <td colspan="4">Total for the day</td>
                                        <td class="text-end" t-out="totals['expected']" t-options="money"/>
                                        <td class="text-end" t-out="totals['met']" t-options="money"/>
                                        <td class="text-end text-danger" t-out="totals['shortfall']" t-options="money"/>
                                        <td class="text-end" t-out="totals['arrears_bf']" t-options="money"/>
                                        <td colspan="3"/>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>
                    </t>
                    <p class="small text-muted mt-3">
                        A member defaults on a day when the installment due that day is not fully paid by the end of it;
                        payments clear older arrears first. Days late counts from the oldest unpaid earlier installment.
                        Total arrears is what is unpaid after the day. Loan balance is today's outstanding balance.
                        * includes cash submitted by the officer still awaiting the manager's confirmation.
                    </p>
                </div>
            </t>
        </t>
    </template>
</odoo>
