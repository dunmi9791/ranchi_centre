<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="digest_digest_view_form" model="ir.ui.view">
        <field name="name">digest.digest.view.form.inherit.ranchi</field>
        <field name="model">digest.digest</field>
        <field name="inherit_id" ref="digest.digest_digest_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='kpis']/group[last()]" position="before">
                <group name="kpi_ranchi" string="Ranchi Centre"
                       groups="ranchi_centre.group_ranchi_officer,ranchi_centre.group_ranchi_auditor">
                    <field name="kpi_ranchi_disbursed"/>
                    <field name="kpi_ranchi_collected"/>
                    <field name="kpi_ranchi_defaults"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
