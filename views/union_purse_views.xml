<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== Purse entries ===================== -->
    <record id="view_ranchi_union_purse_line_list" model="ir.ui.view">
        <field name="name">ranchi.union.purse.line.list</field>
        <field name="model">ranchi.union.purse.line</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-info="state == 'draft'">
                <field name="date"/>
                <field name="union_id" optional="show"/>
                <field name="name"/>
                <field name="origin" widget="badge"/>
                <field name="loan_id" optional="show"/>
                <field name="member_id" optional="hide"/>
                <field name="signed_amount" string="Amount" sum="Total"/>
                <field name="move_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"/>
            </list>
        </field>
    </record>

    <record id="view_ranchi_union_purse_line_form" model="ir.ui.view">
        <field name="name">ranchi.union.purse.line.form</field>
        <field name="model">ranchi.union.purse.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object" string="Post" class="btn-primary"
                            invisible="state != 'draft' or origin != 'manual'"
                            groups="ranchi_centre.group_ranchi_manager"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancelled' or origin != 'manual'"
                            groups="ranchi_centre.group_ranchi_manager"
                            confirm="Cancel this purse entry? A posted entry is reversed in accounting."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="state != 'draft'" placeholder="e.g. Union end-of-year party"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="purse_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="union_id"/>
                            <field name="direction" widget="radio" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="origin"/>
                            <field name="journal_id" readonly="state != 'draft'"
                                   required="origin == 'manual'" invisible="origin != 'manual'"
                                   options="{'no_create': True}"/>
                            <field name="loan_id" invisible="not loan_id"/>
                            <field name="member_id" invisible="not loan_id"/>
                            <field name="move_id" invisible="not move_id"/>
                            <field name="posted_by_id" invisible="not posted_by_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ranchi_union_purse_line_search" model="ir.ui.view">
        <field name="name">ranchi.union.purse.line.search</field>
        <field name="model">ranchi.union.purse.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="union_id"/>
                <field name="loan_id"/>
                <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter name="fees" string="Union Purse Fees" domain="[('origin', '=', 'fee')]"/>
                <filter name="manual" string="Manager Entries" domain="[('origin', '=', 'manual')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_union" string="Union" context="{'group_by': 'union_id'}"/>
                    <filter name="group_origin" string="Origin" context="{'group_by': 'origin'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ranchi_union_purse_line" model="ir.actions.act_window">
        <field name="name">Purse Entries</field>
        <field name="res_model">ranchi.union.purse.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_origin': 'manual'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No union purse entries yet</p>
            <p>Union purse fees are added automatically when a loan's fees are collected. Managers can record money in or out of a union's purse here.</p>
        </field>
    </record>

    <!-- ===================== Purses ===================== -->
    <record id="view_ranchi_union_purse_list" model="ir.ui.view">
        <field name="name">ranchi.union.purse.list</field>
        <field name="model">ranchi.union.purse</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="union_id"/>
                <field name="loan_type_id" optional="show"/>
                <field name="credit_officer_id" optional="show"/>
                <field name="total_credit" sum="Total" optional="hide"/>
                <field name="total_debit" sum="Total" optional="hide"/>
                <field name="balance" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ranchi_union_purse_form" model="ir.ui.view">
        <field name="name">ranchi.union.purse.form</field>
        <field name="model">ranchi.union.purse</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <button name="action_new_entry" type="object" string="New Entry" class="btn-primary"
                            groups="ranchi_centre.group_ranchi_manager"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_union" type="object" class="oe_stat_button" icon="fa-users" string="Union"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="union_id"/>
                            <field name="loan_type_id"/>
                            <field name="credit_officer_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="total_credit"/>
                            <field name="total_debit"/>
                            <field name="balance" class="fw-bold"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Entries" name="entries">
                            <field name="line_ids" readonly="1">
                                <list decoration-muted="state == 'cancelled'" decoration-info="state == 'draft'">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="origin" widget="badge"/>
                                    <field name="loan_id"/>
                                    <field name="signed_amount" string="Amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="state" widget="badge" decoration-success="state == 'posted'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ranchi_union_purse_search" model="ir.ui.view">
        <field name="name">ranchi.union.purse.search</field>
        <field name="model">ranchi.union.purse</field>
        <field name="arch" type="xml">
            <search>
                <field name="union_id"/>
                <field name="loan_type_id"/>
                <field name="credit_officer_user_id"/>
                <filter name="my_unions" string="My Unions" domain="[('credit_officer_user_id', '=', uid)]"/>
                <filter name="with_balance" string="With Money" domain="[('balance', '!=', 0)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_loan_type" string="Loan Type" context="{'group_by': 'loan_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ranchi_union_purse" model="ir.actions.act_window">
        <field name="name">Union Purses</field>
        <field name="res_model">ranchi.union.purse</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No union purses yet</p>
            <p>Every union gets its purse when it is created.</p>
        </field>
    </record>
</odoo>
