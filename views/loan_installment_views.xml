<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ranchi_loan_installment_list" model="ir.ui.view">
        <field name="name">ranchi.loan.installment.list</field>
        <field name="model">ranchi.loan.installment</field>
        <field name="arch" type="xml">
            <list create="false" default_order="date_due, id"
                  decoration-danger="status == 'overdue'" decoration-warning="status == 'due'" decoration-success="state == 'paid'">
                <field name="date_due"/>
                <field name="loan_id"/>
                <field name="sequence" string="#"/>
                <field name="member_id"/>
                <field name="union_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="amount_paid" sum="Total"/>
                <field name="amount_residual" sum="Total"/>
                <field name="days_overdue" optional="show"/>
                <field name="last_payment_date" optional="hide"/>
                <field name="status" widget="badge"
                       decoration-danger="status == 'overdue'" decoration-warning="status == 'due'"
                       decoration-success="status == 'paid'" decoration-info="status == 'not_due'"/>
                <field name="state" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ranchi_loan_installment_form" model="ir.ui.view">
        <field name="name">ranchi.loan.installment.form</field>
        <field name="model">ranchi.loan.installment</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="loan_id"/>
                            <field name="sequence"/>
                            <field name="member_id"/>
                            <field name="union_id"/>
                            <field name="date_due"/>
                        </group>
                        <group>
                            <field name="amount_principal"/>
                            <field name="amount_service"/>
                            <field name="amount_total"/>
                            <field name="amount_paid"/>
                            <field name="amount_residual"/>
                            <field name="status"/>
                            <field name="move_line_id" groups="account.group_account_readonly"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="repayment_ids">
                        <list>
                            <field name="date"/>
                            <field name="amount"/>
                            <field name="source"/>
                            <field name="collection_id"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ranchi_loan_installment_search" model="ir.ui.view">
        <field name="name">ranchi.loan.installment.search</field>
        <field name="model">ranchi.loan.installment</field>
        <field name="arch" type="xml">
            <search>
                <field name="loan_id"/>
                <field name="member_id"/>
                <field name="union_id"/>
                <filter name="disbursed" string="Active Loans" domain="[('loan_state', '=', 'disbursed')]"/>
                <filter name="unpaid" string="Unpaid" domain="[('state', '!=', 'paid')]"/>
                <filter name="due_today" string="Due Today" domain="[('status', '=', 'due')]"/>
                <filter name="overdue" string="Overdue" domain="[('status', '=', 'overdue')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter name="due_date" string="Due Date" date="date_due"/>
                <group expand="0" string="Group By">
                    <filter name="group_union" string="Union" context="{'group_by': 'union_id'}"/>
                    <filter name="group_member" string="Member" context="{'group_by': 'member_id'}"/>
                    <filter name="group_due" string="Due Week" context="{'group_by': 'date_due:week'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ranchi_loan_installment_pivot" model="ir.ui.view">
        <field name="name">ranchi.loan.installment.pivot</field>
        <field name="model">ranchi.loan.installment</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="union_id" type="row"/>
                <field name="date_due" interval="week" type="col"/>
                <field name="amount_total" type="measure"/>
                <field name="amount_residual" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_ranchi_loan_installment_graph" model="ir.ui.view">
        <field name="name">ranchi.loan.installment.graph</field>
        <field name="model">ranchi.loan.installment</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="True">
                <field name="date_due" interval="week"/>
                <field name="amount_residual" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_ranchi_loan_installment" model="ir.actions.act_window">
        <field name="name">Installments</field>
        <field name="res_model">ranchi.loan.installment</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="context">{'search_default_disbursed': 1, 'search_default_unpaid': 1, 'search_default_group_union': 1}</field>
    </record>
</odoo>
