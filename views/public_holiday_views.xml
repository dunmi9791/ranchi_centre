<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ranchi_public_holiday_list" model="ir.ui.view">
        <field name="name">resource.calendar.leaves.ranchi.public.holiday.list</field>
        <field name="model">resource.calendar.leaves</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="date_from desc">
                <field name="name" string="Holiday" required="1"/>
                <field name="date_from" string="Start"/>
                <field name="date_to" string="End"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="calendar_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_ranchi_public_holiday" model="ir.actions.act_window">
        <field name="name">Public Holidays</field>
        <field name="res_model">resource.calendar.leaves</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_ranchi_public_holiday_list"/>
        <field name="domain">[('resource_id', '=', False)]</field>
        <field name="context">{'default_company_id': allowed_company_ids[0], 'default_calendar_id': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a public holiday</p>
            <p>Installments due on a public holiday move to the next union day (weekly loans)
                or the next working day (daily and monthly loans). Upcoming schedules are updated
                as soon as the holiday is saved; removing a holiday does not move them back.</p>
        </field>
    </record>
</odoo>
