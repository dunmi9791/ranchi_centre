<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ranchi_withdrawal_request_list" model="ir.ui.view">
        <field name="name">ranchi.withdrawal.request.list</field>
        <field name="model">ranchi.withdrawal.request</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('rejected', 'cancelled')">
                <field name="name"/>
                <field name="request_date"/>
                <field name="member_id"/>
                <field name="union_id" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="fee_amount" optional="hide"/>
                <field name="savings_available" optional="show"/>
                <field name="paid_date" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'" decoration-info="state in ('submitted', 'approved_l1')"
                       decoration-warning="state == 'approved'" decoration-danger="state == 'rejected'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ranchi_withdrawal_request_form" model="ir.ui.view">
        <field name="name">ranchi.withdrawal.request.form</field>
        <field name="model">ranchi.withdrawal.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state not in ('submitted', 'approved_l1')" groups="ranchi_centre.group_ranchi_accountant,ranchi_centre.group_ranchi_manager"/>
                    <button name="action_open_pay_wizard" type="object" string="Pay" class="btn-primary"
                            invisible="state != 'approved'" groups="ranchi_centre.group_ranchi_accountant,ranchi_centre.group_ranchi_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state not in ('submitted', 'approved_l1', 'approved')" groups="ranchi_centre.group_ranchi_accountant,ranchi_centre.group_ranchi_manager"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'submitted', 'approved_l1', 'approved')"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('rejected', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="member_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="union_id"/>
                            <field name="request_date" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="approval_levels" invisible="1"/>
                        </group>
                        <group>
                            <field name="savings_balance"/>
                            <field name="savings_available"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="fee_amount"/>
                            <field name="net_amount"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" readonly="state != 'draft'"/>
                        <field name="rejection_reason" invisible="state != 'rejected'"/>
                    </group>
                    <group string="Processing" invisible="state in ('draft', 'submitted')">
                        <group>
                            <field name="first_approver_id" invisible="not first_approver_id"/>
                            <field name="approver_id" invisible="not approver_id"/>
                            <field name="journal_id" invisible="state != 'paid'"/>
                            <field name="paid_date" invisible="state != 'paid'"/>
                        </group>
                        <group>
                            <field name="hold_transaction_id" invisible="not hold_transaction_id"/>
                            <field name="payment_transaction_id" invisible="not payment_transaction_id"/>
                            <field name="fee_transaction_id" invisible="not fee_transaction_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ranchi_withdrawal_request_kanban" model="ir.ui.view">
        <field name="name">ranchi.withdrawal.request.kanban</field>
        <field name="model">ranchi.withdrawal.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="name"/>
                <field name="member_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <strong><field name="name"/></strong>
                            <field name="amount" widget="monetary"/>
                        </div>
                        <div><field name="member_id"/></div>
                        <div class="text-muted"><field name="request_date"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_ranchi_withdrawal_request_search" model="ir.ui.view">
        <field name="name">ranchi.withdrawal.request.search</field>
        <field name="model">ranchi.withdrawal.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="member_id"/>
                <field name="union_id"/>
                <filter name="to_approve" string="To Approve" domain="[('state', 'in', ('submitted', 'approved_l1'))]"/>
                <filter name="to_pay" string="To Pay" domain="[('state', '=', 'approved')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_union" string="Union" context="{'group_by': 'union_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ranchi_withdrawal_request" model="ir.actions.act_window">
        <field name="name">Withdrawal Requests</field>
        <field name="res_model">ranchi.withdrawal.request</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>
