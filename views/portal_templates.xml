<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_ranchi" name="Portal My Home: Ranchi" inherit_id="portal.portal_my_home" priority="45">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/account/static/src/img/Bill.svg'"/>
                <t t-set="title">My Savings</t>
                <t t-set="url" t-value="'/my/savings'"/>
                <t t-set="text">Balance, deposits and withdrawals</t>
                <t t-set="placeholder_count" t-value="'ranchi_savings_count'"/>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/account/static/src/img/Bill.svg'"/>
                <t t-set="title">My Loans</t>
                <t t-set="url" t-value="'/my/loans'"/>
                <t t-set="text">Loan balance and repayment schedule</t>
                <t t-set="placeholder_count" t-value="'ranchi_loan_count'"/>
            </t>
        </div>
    </template>

    <template id="portal_breadcrumbs_ranchi" name="Portal breadcrumbs: Ranchi" inherit_id="portal.portal_breadcrumbs" priority="45">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'ranchi_savings'" class="breadcrumb-item active">My Savings</li>
            <li t-if="page_name == 'ranchi_loans'" t-attf-class="breadcrumb-item #{'active' if not loan else ''}">
                <a t-if="loan" href="/my/loans">My Loans</a>
                <t t-else="">My Loans</t>
            </li>
            <li t-if="page_name == 'ranchi_loans' and loan" class="breadcrumb-item active"><t t-out="loan.name"/></li>
        </xpath>
    </template>

    <template id="portal_my_savings" name="My Savings">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Savings</t>
            </t>
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="border rounded p-3 text-center">
                        <div class="text-muted">Balance</div>
                        <h3 t-out="partner.savings_balance" t-options="{'widget': 'monetary', 'display_currency': partner.currency_id}"/>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 text-center">
                        <div class="text-muted">On hold</div>
                        <h3 t-out="partner.savings_on_hold" t-options="{'widget': 'monetary', 'display_currency': partner.currency_id}"/>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 text-center">
                        <div class="text-muted">Available</div>
                        <h3 t-out="partner.savings_available" t-options="{'widget': 'monetary', 'display_currency': partner.currency_id}"/>
                    </div>
                </div>
            </div>
            <t t-if="pending_requests">
                <h5>Pending withdrawal requests</h5>
                <ul>
                    <li t-foreach="pending_requests" t-as="req">
                        <span t-field="req.name"/>: <span t-out="req.amount" t-options="{'widget': 'monetary', 'display_currency': req.currency_id}"/>
                        (<span t-field="req.state"/>)
                    </li>
                </ul>
            </t>
            <t t-if="not transactions">
                <p>There are no savings transactions yet.</p>
            </t>
            <t t-else="">
                <table class="table table-sm o_portal_my_doc_table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Reference</th>
                            <th>Type</th>
                            <th>Note</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="transactions" t-as="tx">
                            <td><span t-field="tx.date"/></td>
                            <td><span t-field="tx.name"/></td>
                            <td><span t-field="tx.type"/></td>
                            <td><span t-field="tx.note"/></td>
                            <td t-attf-class="text-end #{'text-danger' if tx.signed_amount &lt; 0 else 'text-success'}">
                                <span t-out="tx.signed_amount" t-options="{'widget': 'monetary', 'display_currency': tx.currency_id}"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div t-if="pager" class="o_portal_pager text-center">
                    <t t-call="portal.pager"/>
                </div>
            </t>
        </t>
    </template>

    <template id="portal_my_loans" name="My Loans">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Loans</t>
            </t>
            <t t-if="not loans">
                <p>You have no loans.</p>
            </t>
            <t t-else="">
                <table class="table table-sm o_portal_my_doc_table">
                    <thead>
                        <tr>
                            <th>Loan</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th class="text-end">Approved</th>
                            <th class="text-end">Repaid</th>
                            <th class="text-end">Balance</th>
                            <th>Next due</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="loans" t-as="loan">
                            <td><a t-attf-href="/my/loans/#{loan.id}"><span t-field="loan.name"/></a></td>
                            <td><span t-field="loan.loan_type_id.name"/></td>
                            <td><span t-field="loan.state"/></td>
                            <td class="text-end"><span t-out="loan.amount_approved" t-options="{'widget': 'monetary', 'display_currency': loan.currency_id}"/></td>
                            <td class="text-end"><span t-out="loan.amount_paid" t-options="{'widget': 'monetary', 'display_currency': loan.currency_id}"/></td>
                            <td class="text-end"><span t-out="loan.balance" t-options="{'widget': 'monetary', 'display_currency': loan.currency_id}"/></td>
                            <td><span t-field="loan.next_due_date"/></td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </t>
    </template>

    <template id="portal_my_loan" name="My Loan">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title"><t t-out="loan.name"/></t>
            </t>
            <div class="row mb-3">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-5">Loan type</dt><dd class="col-7"><span t-field="loan.loan_type_id.name"/></dd>
                        <dt class="col-5">Status</dt><dd class="col-7"><span t-field="loan.state"/></dd>
                        <dt class="col-5">Approved</dt><dd class="col-7"><span t-out="loan.amount_approved" t-options="{'widget': 'monetary', 'display_currency': loan.currency_id}"/></dd>
                        <dt class="col-5">Total repayable</dt><dd class="col-7"><span t-out="loan.total_repayable" t-options="{'widget': 'monetary', 'display_currency': loan.currency_id}"/></dd>
                        <dt class="col-5">Repaid</dt><dd class="col-7"><span t-out="loan.amount_paid" t-options="{'widget': 'monetary', 'display_currency': loan.currency_id}"/></dd>
                        <dt class="col-5">Balance</dt><dd class="col-7"><span t-out="loan.balance" t-options="{'widget': 'monetary', 'display_currency': loan.currency_id}"/></dd>
                    </dl>
                </div>
            </div>
            <table class="table table-sm o_portal_my_doc_table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Due date</th>
                        <th class="text-end">Amount</th>
                        <th class="text-end">Paid</th>
                        <th class="text-end">Residual</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="loan.installment_ids" t-as="inst">
                        <td><span t-field="inst.sequence"/></td>
                        <td><span t-field="inst.date_due"/></td>
                        <td class="text-end"><span t-out="inst.amount_total" t-options="{'widget': 'monetary', 'display_currency': loan.currency_id}"/></td>
                        <td class="text-end"><span t-out="inst.amount_paid" t-options="{'widget': 'monetary', 'display_currency': loan.currency_id}"/></td>
                        <td class="text-end"><span t-out="inst.amount_residual" t-options="{'widget': 'monetary', 'display_currency': loan.currency_id}"/></td>
                        <td><span t-field="inst.status"/></td>
                    </tr>
                </tbody>
            </table>
        </t>
    </template>
</odoo>
