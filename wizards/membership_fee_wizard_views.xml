<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ranchi_membership_fee_wizard_form" model="ir.ui.view">
        <field name="name">ranchi.membership.fee.wizard.form</field>
        <field name="model">ranchi.membership.fee.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="partner_id"/>
                        <field name="amount"/>
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="register_payment"/>
                        <field name="journal_id" invisible="not register_payment" required="register_payment"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Create Invoice" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
