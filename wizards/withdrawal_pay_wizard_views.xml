<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ranchi_withdrawal_pay_wizard_form" model="ir.ui.view">
        <field name="name">ranchi.withdrawal.pay.wizard.form</field>
        <field name="model">ranchi.withdrawal.pay.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="request_id"/>
                        <field name="amount"/>
                        <field name="fee_amount"/>
                        <field name="net_amount"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="journal_id" options="{'no_create': True}"/>
                        <field name="pay_date"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Pay Out" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
