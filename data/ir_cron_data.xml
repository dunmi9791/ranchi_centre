<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_savings_interest_accrual" model="ir.cron">
            <field name="name">Ranchi: monthly savings interest accrual</field>
            <field name="model_id" ref="model_ranchi_savings_rate"/>
            <field name="state">code</field>
            <field name="code">model._cron_accrue_interest()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="False"/>
        </record>
        <record id="cron_api_request_cleanup" model="ir.cron">
            <field name="name">Ranchi: purge old API idempotency records</field>
            <field name="model_id" ref="model_ranchi_api_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
